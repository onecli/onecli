{
  "name": "@onecli/gateway",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "cargo build --release --bin onecli-gateway",
    "dev": "cargo run",
    "check": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check && RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps --quiet",
    "lint": "cargo fmt --all --check",
    "format:check": "cargo fmt --all --check",
    "check-types": "cargo clippy --workspace --all-targets -- -D warnings",
    "test": "cargo test --workspace",
    "check-docs": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps --quiet"
  }
}
