    "SLACK_SHARED_SIGNING_SECRET",
    "SLACK_SHARED_APP_ID",
    "SLACK_SHARED_APP_MANAGER_APPROVED",
    "ANTHROPIC_API_BASE_URL",
    "OPENAI_API_BASE_URL",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@onecli/gateway#build": {
      "inputs": ["crates/**", "Cargo.toml", "Cargo.lock"],
      "outputs": ["target/release/**"]
    },
    "@onecli/ssh-terminator#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TERMINATOR_*"]
    },
    "@onecli/gateway#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "EDITION",
        "DATABASE_URL",
        "SECRET_ENCRYPTION_KEY",
        "KMS_KEY_ARN",
        "AWS_REGION",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "REDIS_TLS",
        "COGNITO_USER_POOL_ID",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "NOTION_CLIENT_ID",
        "NOTION_CLIENT_SECRET",
        "DROPBOX_CLIENT_ID",
        "DROPBOX_CLIENT_SECRET",
        "SUPABASE_CLIENT_ID",
        "SUPABASE_CLIENT_SECRET",
        "ZOOM_CLIENT_ID",
        "ZOOM_CLIENT_SECRET",
        "LINKEDIN_CLIENT_ID",
        "LINKEDIN_CLIENT_SECRET",
        "MONDAY_CLIENT_ID",
        "MONDAY_CLIENT_SECRET",
        "ATTIO_CLIENT_ID",
        "ATTIO_CLIENT_SECRET",
        "SENTRY_CLIENT_ID",
        "SENTRY_CLIENT_SECRET",
        "HUBSPOT_CLIENT_ID",
        "HUBSPOT_CLIENT_SECRET",
        "LINEAR_CLIENT_ID",
        "LINEAR_CLIENT_SECRET",
        "FATHOM_CLIENT_ID",
        "FATHOM_CLIENT_SECRET",
        "ZOHO_CRM_CLIENT_ID",
        "ZOHO_CRM_CLIENT_SECRET"
      ]
    },
    "@onecli/gateway#check": {
      "inputs": ["crates/**", "Cargo.toml"]
    },
    "@onecli/gateway#check-types": {
      "inputs": ["crates/**", "Cargo.toml", "Cargo.lock"],
      "outputs": []
    },
    "@onecli/gateway#lint": {
      "inputs": ["crates/**", "Cargo.toml"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "cache": false,
      "env": ["ONECLI_TEST_HERMETIC"]
    },
    "@onecli/gateway#test": {
      "inputs": ["crates/**", "Cargo.toml", "Cargo.lock"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
