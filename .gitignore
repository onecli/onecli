# Dependencies
node_modules
.pnp
.pnp.js

# Local env files. ONE runtime file per checkout: .env, created and topped up
# by `pnpm dev` (docker/.env — a self-host install's copy, written by
# `pnpm run setup` — is matched by the same pattern).
.env
.env.local
# The wizard's "Reset" archives (docker/.env.bak-<timestamp>) and the env
# engine's crash-leftover tmp files hold real secrets — never committable.
.env.bak-*
..env.*.tmp
# Files from the multi-file era — no longer read, still ignored so a leftover
# personal copy can never be committed.
.env.oss
.env.onprem
.env.dev.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
next-env.d.ts
out/
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Prisma
packages/db/prisma/*.db

# PGlite local data
data/

# CDK
cdk.out
cdk.out.*

