{
  "name": "@onecli/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0 AND LicenseRef-OneCLI-Enterprise",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers/index.ts",
    "./services/*": "./src/services/*.ts",
    "./routes/*": "./src/routes/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./validations/*": "./src/validations/*.ts",
    "./apps/*": "./src/apps/*.ts",
    "./apps/app-permissions": "./src/apps/app-permissions/index.ts",
    "./apps/app-permissions/*": "./src/apps/app-permissions/*.ts",
    "./apps/oauth/*": "./src/apps/oauth/*.ts",
    "./ee": "./src/ee/index.ts",
    "./ee/*": "./src/ee/*.ts",
    "./ee/granular-access": "./src/ee/granular-access/index.ts",
    "./ee/scim": "./src/ee/scim/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "test": "vitest run",
    "test:licensing": "vitest run src/licensing",
    "test:scim": "vitest run src/ee/scim src/ee/services/org-directory-service.test.ts src/ee/routes/org-scim-tokens.test.ts"
  },
  "dependencies": {
    "@1password/sdk": "^0.4.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1014.0",
    "@aws-sdk/client-kms": "^3.1014.0",
    "@aws-sdk/client-marketplace-entitlement-service": "^3.1118.0",
    "@aws-sdk/client-marketplace-metering": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1014.0",
    "@onecli/agent-protocol": "workspace:*",
    "@onecli/db": "workspace:*",
    "@onecli/ssh-cert": "workspace:*",
    "better-auth": "1.6.26",
    "croner": "^10.0.1",
    "hono": "^4.12.0",
    "ioredis": "^5.10.1",
    "nanoid": "^5.1.9",
    "pino": "^10.3.1",
    "stripe": "^20.4.0",
    "tldts": "^7.4.4",
    "undici": "^8.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@onecli/eslint-config": "workspace:*",
    "@onecli/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  }
}
