generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organization, Workspace & User ────────────────────────────────────────

// Cloud-only: an Organization is the billing + collaboration entity. Holds
// subscription state, Stripe customer, and members. A user may belong to
// multiple organizations (today: one auto-created on signup; future: invited
// to others, can create more). Workspaces under an org share its plan/quotas.
model Organization {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  stripeCustomerId    String?  @unique @map("stripe_customer_id")
  subscriptionStatus  String   @default("free") @map("subscription_status")
  // Cloud-only (inert in OSS): ops-set per-org agent-cap override (SQL only,
  // no UI) — lets a self-serve org exceed its plan's maxAgents without moving
  // to the sales-managed enterprise plan. Null = plan default.
  maxAgentsOverride   Int?     @map("max_agents_override")
  // Cloud-only (inert in OSS): ops-set per-org seat-cap override (SQL only,
  // no UI) — the seat twin of maxAgentsOverride, for negotiated deals that
  // buy extra seats without moving to the sales-managed enterprise plan.
  // Null = plan default. Seats in use = members + pending invitations, so
  // this caps that same total.
  maxMembersOverride  Int?     @map("max_members_override")
  awsExternalId       String?  @map("aws_external_id")
  // App-availability posture (step 7): "open" = every app connectable (default,
  // = today's behavior); "restricted" = allowlist — an app is available to a
  // workspace when an AppAvailabilityRule that grants it names one of the workspace's
  // WorkspaceAccess people. Cloud/EE-only (directory-dependent); inert in OSS.
  appAvailabilityMode String   @default("open") @map("app_availability_mode") // "open" | "restricted"
  // Cloud-only (inert in OSS): members of this org's verified domains must
  // sign in through the org's SSO connection (break-glass via
  // OrganizationMember.ssoExempt).
  ssoRequired         Boolean  @default(false) @map("sso_required")
  // Cloud-only (inert in OSS): first SSO login on a verified domain
  // auto-joins the org as a member.
  jitEnabled          Boolean  @default(true) @map("jit_enabled")
  // The org's creation world on the hosted cloud platform: false = hosted-only
  // creation (the default for every org), true = BYO-only creation (hosted
  // starts with an onboarding call). Set MANUALLY by the cloud operator —
  // never written by application code. Inert on self-host, where creation is
  // ungated in both directions.
  byoLegacy           Boolean  @default(false) @map("byo_legacy")
  // The MIXED creation world (only read when byoLegacy is false): hosted stays
  // the default door, and BYO creation is additionally allowed — the gradual
  // migration path for a legacy customer moving to hosted. byoLegacy=true wins
  // (this column is never consulted there). Set MANUALLY by the cloud
  // operator, like byoLegacy. Inert on self-host.
  byoEnabled          Boolean  @default(false) @map("byo_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspaces                   Workspace[]
  members                      OrganizationMember[]
  invitations                  Invitation[]
  secrets                      Secret[]
  appConnections               AppConnection[]
  appConfigs                   AppConfig[]
  policyRulesV2                PolicyRuleV2[]
  apiKeys                      ApiKey[]
  auditLogs                    AuditLog[]
  budgets                      Budget[] // cloud-only: per-secret spend budgets for this org (inert in OSS)
  skills                       Skill[]
  domains                      OrganizationDomain[]
  ssoConnections               OrganizationSsoConnection[]
  scimTokens                   OrganizationScimToken[]
  groups                       Group[]
  appAvailabilityRules         AppAvailabilityRule[]
  groupRoleMappings            GroupRoleMapping[]
  channelIntegrations          ChannelIntegration[]
  userProvisions               UserProvision[]
  awsMarketplace               AwsMarketplaceSubscription? // cloud-only: AWS Marketplace billing link (inert in OSS)
  awsMarketplaceMeteredRecords AwsMarketplaceMeteredRecord[]

  @@map("organizations")
}

// ── AWS Marketplace billing (plans/aws-marketplace-listing.md) ────────────

// Cloud-only (inert in OSS): links an Organization to an AWS Marketplace
// buyer account (Concurrent Agreements integration: the buyer's AWS account
// id from ResolveCustomer is the customer identity; the legacy
// CustomerIdentifier is not populated for new listings and is never stored).
// One org per marketplace buyer account and vice versa.
// `status`: "pending" (token resolved, no active license yet) |
// "subscribed" (≥1 active license) | "unsubscribed" (no active licenses).
model AwsMarketplaceSubscription {
  id                   String    @id @default(uuid())
  organizationId       String    @unique @map("organization_id")
  // From ResolveCustomer — the buyer's AWS account id.
  customerAwsAccountId String    @unique @map("customer_aws_account_id")
  productCode          String    @map("product_code")
  status               String    @default("pending")
  // Aggregate committed agent entitlement across all ACTIVE licenses.
  // Overage above this is metered, not blocked.
  entitledAgents       Int       @default(0) @map("entitled_agents")
  // Latest expiry across active licenses (the whole link's horizon).
  contractExpiresAt    DateTime? @map("contract_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  licenses     AwsMarketplaceLicense[]

  @@map("aws_marketplace_subscriptions")
}

// Cloud-only (inert in OSS): one AWS Marketplace license — the unit of a
// Concurrent Agreement. A buyer can hold several active licenses for the
// same product at once (distinct offers, entitlements, and rate cards);
// the LicenseArn is the primary identifier AWS keys entitlements and
// metering on. `status`: "active" | "deprovisioned".
model AwsMarketplaceLicense {
  id              String    @id @default(uuid())
  subscriptionId  String    @map("subscription_id")
  licenseArn      String    @unique @map("license_arn")
  status          String    @default("active")
  // Committed agents on this license (sum of its active entitlements).
  entitledAgents  Int       @default(0) @map("entitled_agents")
  // Latest entitlement expiry on this license.
  expiresAt       DateTime? @map("expires_at")
  // Last GetEntitlements rows for this license, verbatim, for audit.
  rawEntitlements Json?     @map("raw_entitlements")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subscription AwsMarketplaceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("aws_marketplace_licenses")
}

// Cloud-only (inert in OSS): one successful BatchMeterUsage report,
// attributed to the license (Concurrent Agreements: usage is billed against
// a specific LicenseArn's rate card). The unique (organizationId,
// dimension, contractYearStart, quantityOrdinal) key makes annual
// agent-year metering idempotent: each extra agent slot is metered exactly
// once per contract year.
model AwsMarketplaceMeteredRecord {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  // License this usage was billed against.
  licenseArn        String   @map("license_arn")
  dimension         String
  quantity          Int
  // Start of the contract year this record bills into.
  contractYearStart DateTime @map("contract_year_start")
  // Ordinal of the first agent slot this record covers (e.g. 11 when the
  // org first exceeds the included 10). With quantity, defines the range.
  quantityOrdinal   Int      @map("quantity_ordinal")
  usageTimestamp    DateTime @map("usage_timestamp")
  // MeteringRecordId returned by AWS.
  meteringRecordId  String?  @map("metering_record_id")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dimension, contractYearStart, quantityOrdinal])
  @@map("aws_marketplace_metered_records")
}

// Cloud-only: links a User to an Organization with a role.
model OrganizationMember {
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  userEmail      String    @map("user_email")
  role           String // "owner" | "admin" | "member"
  // Cloud-only (inert in OSS): "active" | "suspended" — suspended members are
  // treated as non-members by every authorization check (SCIM deprovisioning).
  status         String    @default("active")
  suspendedAt    DateTime? @map("suspended_at")
  // Cloud-only (inert in OSS): break-glass exemption from the org's
  // ssoRequired policy (e.g. an owner who keeps a non-SSO sign-in).
  ssoExempt      Boolean   @default(false) @map("sso_exempt")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  role           String // "admin" | "member"
  token          String   @unique
  status         String   @default("pending") // "pending" | "accepted" | "cancelled" | "expired"
  invitedById    String   @map("invited_by_id")
  invitedByEmail String   @map("invited_by_email")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitationCreator", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([token])
  @@map("invitations")
}

// Cloud-only (inert in OSS): an email domain claimed by an organization and
// proven via DNS TXT — the trust root for SSO home-realm discovery, JIT
// membership, and identity linking. `verifiedAt` null = claimed but pending;
// every trust decision checks verifiedAt, never mere existence.
model OrganizationDomain {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  domain            String    @unique
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at")
  createdByUserId   String?   @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User?        @relation("OrganizationDomainCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@map("organization_domains")
}

// Cloud-only (inert in OSS): a per-organization enterprise SSO connection —
// the app-side record of an identity provider registered with the auth
// backend. Secrets (e.g. an OIDC client secret) live in `credentials`
// (encrypted), never in `config`.
model OrganizationSsoConnection {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  type                String // "saml" | "oidc"
  status              String   @default("pending") // "pending" | "active" | "disabled"
  cognitoProviderName String   @unique @map("cognito_provider_name")
  displayName         String   @map("display_name")
  config              Json? // non-secret settings (metadata URL/XML digest, issuer, client id)
  credentials         String? // encrypted
  createdByUserId     String?  @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User?        @relation("OrganizationSsoConnectionCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@map("organization_sso_connections")
}

// Cloud-only (inert in OSS): hashed bearer tokens for the org's SCIM
// provisioning endpoint. Plaintext is shown once at creation and never
// stored; revocation is soft (row kept for the audit trail).
model OrganizationScimToken {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  tokenHash       String    @unique @map("token_hash") // sha-256
  label           String
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User?        @relation("OrganizationScimTokenCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@map("organization_scim_tokens")
}

model Workspace {
  id                 String   @id @default(uuid())
  name               String?
  organizationId     String   @map("organization_id")
  // URL-friendly slug, unique within an organization (e.g. "default", "production").
  slug               String?
  createdByUserId    String?  @map("created_by_user_id")
  createdByUserEmail String?  @map("created_by_user_email")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  createdByUser    User?             @relation("WorkspaceCreator", fields: [createdByUserId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  apiKeys          ApiKey[]
  agents           Agent[]
  secrets          Secret[]
  policyRulesV2    PolicyRuleV2[]
  auditLogs        AuditLog[]
  vaultConnections VaultConnection[]
  onboardingSurvey OnboardingSurvey?
  appConnections   AppConnection[]
  appConfigs       AppConfig[]
  budgets          Budget[] // cloud-only: per-secret spend budgets for this workspace (inert in OSS)
  accessBindings   WorkspaceAccess[]
  skills           Skill[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String?
  // Self-host identity layer (better-auth): whether the provider proved
  // ownership of `email`. Inert on cloud, where Cognito owns verification.
  emailVerified         Boolean   @default(false) @map("email_verified")
  // Avatar URL from the sign-in provider. Written by better-auth on the
  // self-hosted edition (a social profile always carries one); unused on
  // cloud, where the dashboard renders initials.
  image                 String?
  // Cloud-only (inert in OSS): the SCIM `name` object (formatted/givenName/
  // familyName/…) stored losslessly so IdP-provisioned attributes round-trip;
  // `name` above stays the display string.
  nameComponents        Json?     @map("name_components")
  externalAuthId        String    @unique @map("external_auth_id")
  countryCode           String?   @map("country_code")
  country               String?   @map("country")
  lastLoginAt           DateTime? @map("last_login_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  // Cloud-only (inert in OSS): identity-level deactivation timestamp, set
  // alongside the auth-provider disable when the org owns the identity
  // (e.g. SCIM deprovisioning).
  deactivatedAt         DateTime? @map("deactivated_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organizationMemberships       OrganizationMember[]
  sentInvitations               Invitation[]                  @relation("InvitationCreator")
  apiKeys                       ApiKey[]
  auditLogs                     AuditLog[]
  createdWorkspaces             Workspace[]                   @relation("WorkspaceCreator")
  onboardingSurveys             OnboardingSurvey[]
  createdDomains                OrganizationDomain[]          @relation("OrganizationDomainCreator")
  createdSsoConnections         OrganizationSsoConnection[]   @relation("OrganizationSsoConnectionCreator")
  createdScimTokens             OrganizationScimToken[]       @relation("OrganizationScimTokenCreator")
  groupMemberships              GroupMember[]                 @relation("GroupMemberUser")
  createdGroupMembers           GroupMember[]                 @relation("GroupMemberCreator")
  workspaceAccess               WorkspaceAccess[]             @relation("WorkspaceAccessUser")
  createdWorkspaceAccess        WorkspaceAccess[]             @relation("WorkspaceAccessCreator")
  createdPolicyRulesV2          PolicyRuleV2[]                @relation("PolicyRuleV2Creator")
  policyRuleIdentities          PolicyRuleIdentity[]          @relation("PolicyRuleIdentityUser")
  appAvailabilityRuleIdentities AppAvailabilityRuleIdentity[] @relation("AppAvailabilityRuleIdentityUser")
  createdAppAvailabilityRules   AppAvailabilityRule[]         @relation("AppAvailabilityRuleCreator")
  directConversations           Conversation[]                @relation("ConversationOwner")
  authoredTurns                 Turn[]                        @relation("TurnAuthor")
  uploadedAttachments           ConversationAttachment[]      @relation("AttachmentUploader")
  createdCrons                  AgentCron[]                   @relation("CronCreator")
  channelUserLinks              ChannelUserLink[]             @relation("ChannelUserLinkUser")
  decidedReachGrants            AgentReachGrant[]             @relation("ReachGrantDecider")
  createdChannelIntegrations    ChannelIntegration[]          @relation("ChannelIntegrationCreator")
  createdChannelInstallations   ChannelInstallation[]         @relation("ChannelInstallationCreator")
  createdAgentChannels          AgentChannel[]                @relation("AgentChannelCreator")
  memoryRevisionsAuthored       AgentMemoryRevision[]         @relation("MemoryRevisionAuthor")
  memoryRedactions              AgentMemoryRevision[]         @relation("MemoryRevisionRedactor")
  skillsCreated                 Skill[]                       @relation("SkillCreator")
  processesCreated              SandboxProcess[]              @relation("ProcessCreator")
  watchesCreated                ProcessWatch[]                @relation("WatchCreator")
  sessions                      Session[]
  accounts                      Account[]
  sshKeys                       UserSshKey[]
  provisionedAs                 UserProvision?                @relation("ProvisionedUser")
  createdProvisions             UserProvision[]               @relation("ProvisionCreator")

  @@map("users")
}

model ApiKey {
  id             String   @id @default(uuid())
  scope          String   @default("workspace") // "workspace" | "organization"
  workspaceId    String?  @map("workspace_id")
  organizationId String?  @map("organization_id")
  userId         String   @map("user_id")
  userEmail      String   @map("user_email")
  key            String   @unique // "oc_..." or "oc_org_..." prefix
  name           String?
  // "user" = a person's own key (the CLI/dashboard key — at most one per
  // user+scope, which regenerate/ensure rely on) | "service" = minted by the
  // platform for a machine consumer (e.g. a channel presence's approvals
  // key). Service keys are invisible to the personal-key flows: regenerate,
  // ensure, and the key-listing UI all filter kind "user".
  kind           String   @default("user") // "user" | "service"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id])
  agentChannels AgentChannel[]

  @@index([userId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([scope])
  @@map("api_keys")
}

// ── Workspace data (scoped by workspaceId) ──────────────────────────────────

model Agent {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  name          String
  identifier    String // user-provided machine-readable ID, unique per workspace
  accessToken   String    @unique @map("access_token") // "aoc_..." prefix, used for gateway auth
  // DEPRECATED: never written anymore and surfaced nowhere. Kept nullable for
  // pre-v2 rows so /v1/container-config can resolve an unpinned machine to the
  // workspace's legacy default agent. New agents get NULL.
  isDefault     Boolean?  @map("is_default")
  // "byo" (bring-your-own: laptops, CI) | "hosted" (a platform-run sandbox).
  // On the hosted cloud platform, which kind an org may CREATE is picked by
  // Organization.byoLegacy (the creation worlds); existing agents of either
  // kind keep working everywhere. Self-host creation is ungated.
  kind          String    @default("byo") // "byo" | "hosted"
  // Hosted only — which harness adapter runs inside the sandbox. One value
  // today ("jcode"); the column is the seam that keeps a second adapter cheap.
  harness       String?
  // Hosted only — the user's model OVERRIDE, not "the model this agent runs".
  // Null is the normal, healthy state: the granted LLM key names a provider,
  // and that provider supplies the default (§3.10). The PROVIDER's own id
  // (`claude-sonnet-4-6`), never a harness alias — translating is the
  // adapter's job (§3.5).
  model         String?
  // Which provider the override above belongs to, so a key swap can drop it
  // rather than point the agent at a model its new key cannot serve. Never
  // inferred from the id: harness catalogs carry ids like `opus-4.6` and
  // `gpt-oss-120b-medium` where a prefix rule gets the provider wrong.
  // Coherence with `model`/`effort` is enforced by a CHECK constraint in the
  // migration (Prisma cannot express it).
  modelProvider String?   @map("model_provider")
  // Hosted only — the reasoning-effort override, on OUR scale (see
  // `AgentEffort`). Governed by the same `modelProvider` stamp as `model`.
  effort        String?
  // Hosted only — the per-agent brief (§3.11): the user-authored "what this
  // agent is for", rendered at the top of its generated CLAUDE.md/AGENTS.md.
  instructions  String?
  // The agent's avatar — raster bytes inline (the attachments precedent:
  // self-host's api container has no disk besides Postgres, and one capped
  // image per agent is tiny). `imageKey` is the unguessable serving token:
  // Slack fetches `icon_url` unauthenticated, so the public GET is fenced by
  // this 128-bit random key, rotated on every image change.
  imageData     Bytes?    @map("image_data")
  imageMime     String?   @map("image_mime")
  imageKey      String?   @map("image_key")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  policyRuleIdentities PolicyRuleIdentity[]
  sandbox              Sandbox?
  conversations        Conversation[]
  channels             AgentChannel[]
  crons                AgentCron[]
  memories             AgentMemory[]
  skills               Skill[]
  reachGrants          AgentReachGrant[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("agents")
}

// A registered runner daemon — the outbound-only service that spawns and
// parks hosted-agent sandboxes (plans/hosted-agents-v2.md §3.3). Rows are
// minted by the runner registration API (step 3); the model lands first so
// Sandbox can reference it.
model Runner {
  id           String    @id @default(uuid())
  name         String
  token        String    @unique // "rnr_..." prefix; minted at registration (step 3)
  scope        String    @default("instance") // "instance" (one runner serves the install); org/workspace scoping is additive later
  capabilities Json?
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sandboxes Sandbox[]

  @@map("runners")
}

// A hosted agent's computer: the per-agent compute record. One sandbox per
// agent; the container is disposable, the home is durable behind the
// opaque homeRef (§3.9's home seam — meaning is backend-defined).
model Sandbox {
  id           String    @id @default(uuid())
  agentId      String    @unique @map("agent_id")
  runnerId     String    @map("runner_id")
  status       String    @default("unprovisioned") // "unprovisioned" | "starting" | "running" | "stopped" | "failed"
  containerRef String?   @map("container_ref")
  homeRef      String?   @map("home_ref") // opaque, backend-defined (§3.9)
  lastActiveAt DateTime? @map("last_active_at")

  // The home projection's sync clock (step 9). `desired` is bumped by
  // any write that changes the materialized file set (skills, memory, brief,
  // name); `applied` is set only by the supervisor's home.synced ack.
  // Due when applied < desired AND status = 'running' — a bump never wakes a
  // parked sandbox (the credential-edit precedent): a parked one gets current
  // truth at its next spawn, whose start claim resets applied to 0 so every
  // boot begins with a full sync. Defaults desired=1/applied=0 on purpose:
  // the very first sync is unconditional. `homeSyncClaimedAt` is this
  // arm's ONLY recovery clock (updated_at stays the start/stop arms' stale
  // clock — clocks are single-purpose).
  homeDesiredGeneration Int       @default(1) @map("home_desired_generation")
  homeAppliedGeneration Int       @default(0) @map("home_applied_generation")
  homeSyncClaimedAt     DateTime? @map("home_sync_claimed_at")

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  agent       Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runner      Runner           @relation(fields: [runnerId], references: [id])
  processes   SandboxProcess[]
  sshSessions SshSession[]

  @@index([runnerId])
  @@map("sandboxes")
}

// ── Background processes + watches (plans/hosted-agents-v2.md step 10, §3.9) ──
// A supervisor-managed background process in a hosted agent's sandbox. Truth
// about LIVENESS is supervisor-side (the process is a child of the supervisor
// inside the container); these rows are the durable mirror the keep-awake
// rule and the poll-time sweeps read. `containerRef` is the step-9 sync-ack
// lesson made a column: sandbox rows survive respawns while containers do
// not, so a row whose ref is not the sandbox's CURRENT one must never read
// as live. Rows are keyed (sandboxId, ref) with a supervisor-chosen ref —
// a forged ref cannot cross a tenant boundary by construction.
model SandboxProcess {
  id           String  @id @default(uuid())
  sandboxId    String  @map("sandbox_id")
  // Supervisor-chosen per-boot id (uuid); every write keys (sandboxId, ref).
  ref          String
  // Runner-stamped at report time — never taken from the supervisor payload.
  containerRef String  @map("container_ref")
  command      String
  name         String?
  // "running" | "exited" | "stopped" | "lost". `lost` is control-plane-
  // authored only (the poll-time sweep); it never arrives on the wire.
  status       String  @default("running")
  exitCode     Int?    @map("exit_code")
  signal       String?
  // Last ~1k chars of interleaved stdout+stderr, refreshed by state frames.
  tail         String?

  // Arm-time turn context — anchoring, not authority (the crons doctrine):
  // verified at first insert, write-once, droppable when forged.
  originConversationId String? @map("origin_conversation_id")
  createdByUserId      String? @map("created_by_user_id")

  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sandbox            Sandbox        @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  originConversation Conversation?  @relation("ProcessOrigin", fields: [originConversationId], references: [id], onDelete: SetNull)
  createdBy          User?          @relation("ProcessCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  watches            ProcessWatch[]

  @@unique([sandboxId, ref])
  // The stop arm's keep-awake probe (§3.9) reads (sandbox_id, status).
  @@index([sandboxId, status])
  // The lost sweep scans running rows across all sandboxes.
  @@index([status])
  @@map("sandbox_processes")
}

// A ONE-SHOT wake condition on a process: exit, output pattern (literal
// substring — never a regex, by decision), or silence. Detection lives in
// supervisor memory and dies with the container; the control plane owns the
// durable outcomes — firing the turn, the lost conversion, and expiry.
// `fireClaimedAt` is this row's ONLY claim clock (single-purpose, never
// updated_at — the due-work law). Nothing ever re-arms a watch.
model ProcessWatch {
  id             String  @id @default(uuid())
  processId      String  @map("process_id")
  ref            String
  // "exit" | "pattern" | "silence" — payload coherence is a migration CHECK.
  kind           String
  pattern        String?
  silenceSeconds Int?    @map("silence_seconds")
  // Agent-authored: what the fired turn is instructed to do.
  prompt         String
  // "armed" | "triggered" | "expired" | "canceled" | "fired". `fired` is
  // control-plane-authored (the fire pass); `trigger` says why it triggered.
  status         String  @default("armed")
  // "exited" | "matched" | "silent" | "lost" (`lost` is CP-authored).
  trigger        String?
  excerpt        String?

  expiresAt     DateTime  @map("expires_at")
  triggeredAt   DateTime? @map("triggered_at")
  firedAt       DateTime? @map("fired_at")
  fireClaimedAt DateTime? @map("fire_claimed_at")

  originConversationId String? @map("origin_conversation_id")
  createdByUserId      String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  process            SandboxProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  originConversation Conversation?  @relation("WatchOrigin", fields: [originConversationId], references: [id], onDelete: SetNull)
  createdBy          User?          @relation("WatchCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([processId, ref])
  // The keep-awake watch probe per process.
  @@index([processId, status])
  // The fire claim scan + the expiry sweep.
  @@index([status, expiresAt])
  @@map("process_watches")
}

// ── SSH front door (plans/sandbox-platform.md step 5, §3.8) ──
// One customer SSH session into a hosted agent's sandbox, reported by the
// SSH terminator over its own authenticated surface. LIVENESS truth is the
// lease (`lastHeartbeatAt` within the lease window) — never the status
// column alone: a crashed terminator reports nothing, so every consumer
// (keep-awake, the start-dueness arm, the per-agent cap) reads the lease and
// the stale-session sweep closes lease-expired rows (`lease_expired`). The
// terminator writes `closed` on every clean exit path; `closeReason` says
// why ("client_disconnect" | "revoked" | "max_duration" | "idle_timeout" |
// "agent_deleted" | "wake_timeout" | "relay_error" | "lease_expired" | ...).
model SshSession {
  id          String @id @default(uuid())
  sandboxId   String @map("sandbox_id")
  agentId     String @map("agent_id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  userEmail   String @map("user_email")
  // Terminator-reported (the control plane never sees the TCP peer) — audit
  // metadata, not tamper-proof truth.
  sourceIp    String @map("source_ip")
  certSerial  String @map("cert_serial")
  // "open" | "closed"
  status      String @default("open")

  openedAt        DateTime  @default(now()) @map("opened_at")
  attachedAt      DateTime? @map("attached_at")
  lastHeartbeatAt DateTime  @default(now()) @map("last_heartbeat_at")
  closedAt        DateTime? @map("closed_at")
  closeReason     String?   @map("close_reason")

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  // The keep-awake arm's per-sandbox lease probe (due-work.ts).
  @@index([sandboxId, status])
  // The per-agent session cap count.
  @@index([agentId, status])
  // The stale-session sweep: `status='open' AND last_heartbeat_at < …` runs
  // on EVERY runner poll across ALL sandboxes (not sandbox-scoped), so it
  // needs a status-leading index — the sandbox_id-leading ones above cannot
  // serve it, and the sweep would otherwise sequential-scan a table that only
  // ever grows (closed rows are audit history, pruned only by cascade).
  // The reclaimStaleTurns precedent rides Turn's `@@index([status, updatedAt])`.
  @@index([status, lastHeartbeatAt])
  @@map("ssh_session")
}

// A user's registered SSH public key — the identity half of the SSH front
// door's mint flow. Rows are owned by the person, not a workspace: the same
// key authenticates them to every agent they can reach, so the registry
// lives beside their identity and dies with it (cascade). Only PUBLIC key
// material is ever stored, and a row grants nothing by itself — every mint
// and session-open still re-runs the full access law.
model UserSshKey {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  // User-supplied label ("MacBook Pro"). Not unique: two laptops may share
  // a name; the fingerprint below is the identity.
  name        String
  // Canonical "ssh-ed25519 <base64>" line rebuilt from the PARSED key —
  // never the raw paste, whose free-text comment would make the same key
  // read as two different strings.
  publicKey   String @map("public_key")
  // OpenSSH SHA256 fingerprint ("SHA256:<base64, no padding>"), computed
  // server-side from the key blob — the display and dedupe identity. Never
  // accepted from the client, or the unique constraint below is bypassable.
  fingerprint String

  createdAt  DateTime  @default(now()) @map("created_at")
  // Stamped when a certificate is minted from this key.
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The settings list and the duplicate check on registration; the leading
  // user_id column also serves every per-user lookup, so no separate index.
  @@unique([userId, fingerprint])
  @@map("user_ssh_keys")
}

// One SSH certificate mint — the rate-limit counter for
// POST /v1/agents/:id/ssh-certificate. Deliberately its own table rather
// than counting audit rows: audit writes are best-effort/never-throw, and a
// limiter must not under-count when they fail. Rows are pruned by the
// stale-session sweep after 24h.
model SshCertMint {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  agentId   String   @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")

  // The windowed per-(user, agent) count.
  @@index([userId, agentId, createdAt])
  // The prune sweep.
  @@index([createdAt])
  @@map("ssh_cert_mint")
}

// One continuous exchange with a hosted agent (plans/hosted-agents-v2.md
// step 4). An agent has exactly one computer but MANY conversations, because
// work arrives from sources whose contexts must not bleed into each other —
// a 3am cron run must not land in the middle of yesterday's chat.
//
// Each conversation owns its own harness session inside the shared sandbox
// (§3.6): `harnessSessionRef` is the opaque handle the supervisor passes back
// to `startSession({ resumeSessionRef })` so a later turn resumes THIS
// conversation rather than someone else's.
model Conversation {
  id                String   @id @default(uuid())
  agentId           String   @map("agent_id")
  // Where the conversation comes from. `externalRef` is that source's own id
  // (a Slack thread ts, a cron id) — the pair is what keeps sources apart.
  source            String   @default("web") // "web" | "slack" | "cron" | "watch"
  externalRef       String?  @map("external_ref")
  // The direct thread's owner (step 6's per-user amendment to §3.18): a
  // user's conversation with an agent is ONE thread no matter the surface —
  // their web chat and their Slack DM read and write this same row — and each
  // user has their OWN. At most one per (agent, user), enforced by a partial
  // unique index (WHERE "direct") hand-appended in the migration —
  // deliberately NOT @@unique here, for the same Prisma-6 differ reason as
  // Turn's one-active lock below. A CHECK (also migration-only) guarantees a
  // direct row always carries its owner; group/source conversations leave
  // this null. Cascade: a deleted user takes their private threads with them.
  userId            String?  @map("user_id")
  // True = a user's direct thread (see userId above). Only the get-or-create
  // door mints direct rows; POST /v1/conversations cannot set this.
  //
  // On a direct row `source` records only which door minted it and carries no
  // meaning — the web and provider surfaces share the thread by design, which
  // is exactly what `source`/`externalRef` keep APART for every other
  // conversation.
  direct            Boolean  @default(false)
  title             String?
  // Opaque, adapter-defined (§3.6). Null until the first turn starts a session.
  harnessSessionRef String?  @map("harness_session_ref")
  // The transcript's monotonic cursor, handed out by an atomic increment on
  // THIS row. The row lock is held to commit, so per conversation `seq` order
  // is commit order — which is what makes "fetch history, then tail from the
  // last seq" lossless. A global sequence would not: values are assigned at
  // nextval time, so a lower seq can commit later and be tailed past forever.
  lastSeq           Int      @default(0) @map("last_seq")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agent         Agent                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user          User?                    @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  turns         Turn[]
  events        TurnEvent[]
  attachments   ConversationAttachment[]
  threadLink    ChannelThreadLink?
  cronsHere     AgentCron[]              @relation("CronOrigin")
  processesHere SandboxProcess[]         @relation("ProcessOrigin")
  watchesHere   ProcessWatch[]           @relation("WatchOrigin")

  @@unique([agentId, source, externalRef])
  @@index([agentId, createdAt])
  @@map("conversations")
}

// One round of work: a message in, the agent's whole response out (which may
// include thinking, several tool calls, and streamed text). Not one message —
// the turn is the unit the transcript groups by, usage attaches to, and abort
// cancels.
//
// At most one ACTIVE turn per conversation, enforced by a partial unique index
// over ("queued","dispatched","running") — hand-appended in the migration
// because Prisma's @@unique carries no WHERE clause. Deliberately NOT declared
// as @@unique here: Prisma 6's differ ignores the WHERE and would fight it.
model Turn {
  id             String  @id @default(uuid())
  conversationId String  @map("conversation_id")
  status         String  @default("queued") // "queued" | "dispatched" | "running" | "done" | "failed" | "aborted" | "joining" | "joined"
  // Which door created this turn — "web" or a channel provider id ("slack").
  // On a shared direct thread this is what tells surfaces apart: the mirror
  // suppresses echoes by it, and the web renders a quiet origin chip from it.
  source         String  @default("web")
  // Who spoke. On a direct thread this matches the thread owner; on a group
  // conversation it attributes the speaker per turn. SetNull: group history
  // outlives a deleted user, attribution drops.
  userId         String? @map("user_id")
  message        String
  // WHERE THIS TURN WAS ASKED, when the provider surface has a finer address
  // than the link does (Slack: the DM thread's `thread_ts`). A thread link
  // resolves ONE address per conversation, which is right for a channel
  // thread (the thread IS the conversation) but not for a DM: one direct
  // conversation carries every thread the person opens inside it, so the
  // link cannot say which one a given turn belongs to. Null = the link's own
  // address (top-level DM, channel thread) — every turn before this column
  // and every non-channel door.
  //
  // Provider-opaque by design, exactly like `ChannelThreadLink.externalThreadId`:
  // the platform never parses it, it only hands it back to the provider that
  // minted it.
  sourceThreadId String? @map("source_thread_id")
  // Set when someone asks an in-flight turn to stop. The turn stays active
  // until the sandbox confirms — a request is not an outcome, and a sandbox
  // that never answers is recovered by the stale-turn sweep instead.
  abortRequested Boolean @default(false) @map("abort_requested")
  error          String?
  // A machine-readable reason beside the human `error`, set only when the UI
  // has to do something other than print the sentence — today, offer the fix
  // for a turn that never ran because the agent has no model key. Null for
  // every failure whose message says everything there is to say.
  errorCode      String? @map("error_code")
  usage          Json? // token counts from the terminal report — salvaged even when the close lost the race to a sweep

  // ── Mid-run follow-ups ────────────────────────────────────────────────
  // A message sent while a turn was active is a FOLLOW-UP row: born
  // "joining" (never an active status, so it coexists with the partial
  // index), steered into its target's live run, and either confirmed
  // "joined" (terminal) or promoted in place to "queued" to run as the next
  // turn. `followUpOfTurnId` is the target — kept after promotion as
  // provenance. No FK: the target's deletion cascades through the shared
  // conversation, and a dangling id here is inert.
  followUpOfTurnId String?   @map("follow_up_of_turn_id")
  // The steer claim's own clock, stamped when the dispatch arm hands this
  // follow-up to a runner. Single-purpose (never `updatedAt`, the house
  // law): its presence is also the settle fence's proof that "joined" can
  // only follow a delivery the control plane itself stamped.
  steerDeliveredAt DateTime? @map("steer_delivered_at")
  // Stamped when a parked follow-up is promoted to "queued". The turn
  // ceiling measures promoted rows from HERE, not `createdAt` — a follow-up
  // parked late in a long turn must get a full turn's budget of its own.
  promotedAt       DateTime? @map("promoted_at")
  // Stamped when a cold-dead dispatch (the harness died before ANY observable
  // work — the turn never left "dispatched") was revived in place back to
  // "queued". The once-fence: a second death finds it set and fails the turn
  // terminally. Also restarts the ceiling budget, like `promotedAt`. Single-
  // purpose clock (house law: never `updatedAt`), and deliberately absent
  // from `turnSelect` — the retry is invisible to readers.
  retriedAt        DateTime? @map("retried_at")
  // Stamped when the approaching-ceiling warning was steered into this
  // turn's live run (at most once) — the fence that keeps the warning arm
  // from re-delivering on every poll. Single-purpose clock (house law).
  ceilingWarnedAt  DateTime? @map("ceiling_warned_at")
  // The liveness clock: refreshed by the supervisor's ~60s progress
  // heartbeat while the turn is RUNNING. A running turn whose stamp goes
  // stale is failed as `turn_stalled` (due-work's stall arm); NULL means the
  // agent image predates the heartbeat, and only the ceiling applies.
  // Single-purpose clock (house law: never `updatedAt` — re-dispatch stamps
  // that), and absent from `turnSelect` like its siblings.
  lastProgressAt   DateTime? @map("last_progress_at")

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  conversation Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?                    @relation("TurnAuthor", fields: [userId], references: [id], onDelete: SetNull)
  events       TurnEvent[]
  attachments  ConversationAttachment[]

  @@index([conversationId, createdAt])
  @@index([status, updatedAt])
  @@index([followUpOfTurnId])
  @@map("turns")
}

// A file/image a user sent into a hosted-agent conversation (web upload or
// Slack file_share). The repo's FIRST Bytes column, deliberately: self-host's
// api container has no writable disk besides Postgres, and every byte is
// size-capped at the doors (MAX_ATTACHMENT_BYTES). Reads/writes go ONLY
// through the AttachmentBlobStore provider seam — `storageRef` is the
// per-row backend dispatch key (the ciphertext-shape pattern applied to
// blobs): null = bytes inline in `data`; a future scalable store (S3) writes
// its own key here and leaves `data` null, so mixed rows coexist and a cloud
// cutover needs no migration.
//
// Lifecycle: "pending" (uploaded, not yet on a turn — swept after 24h) →
// "bound" (attached to its turn inside the turn-create transaction; the
// steer arm's carve-out reads this table, so the bind MUST be transactional
// with the turn row) | "failed" (a Slack fetch that never yielded bytes —
// `error` says why; renders as a failed chip and a context-note mention).
model ConversationAttachment {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  turnId         String?  @map("turn_id")
  // Uploader (web) / authenticated speaker (Slack). SetNull like Turn.userId:
  // history outlives a deleted user, attribution drops.
  userId         String?  @map("user_id")
  source         String   @default("web") // door: "web" | a channel provider id
  name           String // sanitized (sanitizeAttachmentName) — safe as a path segment
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  sha256         String
  data           Bytes?
  storageRef     String?  @map("storage_ref")
  status         String   @default("pending") // "pending" | "bound" | "failed"
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         Turn?        @relation(fields: [turnId], references: [id], onDelete: Cascade)
  user         User?        @relation("AttachmentUploader", fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([turnId])
  // The stale-pending sweep runs on EVERY runner poll (seconds): without a
  // status-leading index it sequential-scans the table — and this is the one
  // table that holds megabyte rows.
  @@index([status, createdAt])
  @@map("conversation_attachments")
}

// The durable transcript. NOT every event the sandbox emits: under the delta
// law (§3.17) streamed text is ephemeral and coalesced, and only bounded rows
// land here — messages, tool calls, lifecycle — so a turn costs a handful of
// rows rather than one per token. Append-only, like AuditLog.
model TurnEvent {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  turnId         String   @map("turn_id")
  // Monotonic per conversation (see Conversation.lastSeq). Doubles as the SSE
  // `id:` field, so a reconnect resumes from exactly where it left off.
  seq            Int
  type           String // an AgentEvent type — the canonical vocabulary, never a vendor one
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         Turn         @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([turnId, seq])
  @@map("turn_events")
}

// A scheduled task on a hosted agent (plans/hosted-agents-v2.md step 7). The
// schedule lives HERE, never in the sandbox (§3.7: a native scheduler would
// write state where the platform cannot see, govern, or display it) — dueness
// is computed at runner-poll time from `nextFireAt` (§3.3: no background
// loop), and a fire is just a normal turn in the cron's own conversation
// (source "cron", externalRef = this row's id — that unique pair is what
// makes one persistent run-conversation per cron race-safe for free).
model AgentCron {
  id       String @id @default(uuid())
  agentId  String @map("agent_id")
  // Short label; shows in the dashboard, the delivery header, and the
  // context-bridge note, so the user can tell schedules apart.
  name     String
  // The stored run instruction, fired verbatim (behind the scheduled-run
  // header) as the turn message.
  prompt   String
  // 5-field cron expression, read in `timezone` (an IANA zone name). The
  // expression is validated by the same library that computes occurrences
  // (croner), so a row that exists is always advanceable.
  schedule String
  timezone String

  // The pause switch (user-controlled). Auto-disable ALSO clears this and
  // records why in disabledReason — "authorization" (the creator lost workspace
  // access) | "failures" (5 consecutive failed runs). A user re-enabling
  // clears the reason.
  enabled        Boolean @default(true)
  disabledReason String? @map("disabled_reason")

  // Where run reports are delivered (decided with the user, 2026-08-07):
  // the conversation the schedule was created FROM — a direct thread or a
  // channel conversation. SetNull: losing the origin quiets delivery, never
  // the schedule.
  originConversationId String? @map("origin_conversation_id")
  // Fire-time authorization anchor: the human whose authority the schedule
  // runs under. Null only for creators we could not resolve; SetNull keeps
  // the schedule when the user goes (it then runs on agent authority alone).
  createdByUserId      String? @map("created_by_user_id")

  // The claim predicate. Claiming stamps a short lease here (now + 5min)
  // inside the FOR UPDATE SKIP LOCKED statement, then the real next
  // occurrence — computed in JS from `now` so downtime coalesces into ONE
  // late fire — replaces it before the turn is created.
  nextFireAt          DateTime  @map("next_fire_at")
  lastFiredAt         DateTime? @map("last_fired_at")
  // "ok" | "failed" | "skipped_busy" (previous run still going)
  lastOutcome         String?   @map("last_outcome")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent              Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  originConversation Conversation? @relation("CronOrigin", fields: [originConversationId], references: [id], onDelete: SetNull)
  createdBy          User?         @relation("CronCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([enabled, nextFireAt])
  @@index([agentId])
  @@map("agent_crons")
}

// ── Memory: what an agent knows, visible and correctable (plans/hosted-agents-v2.md step 8, §3.8) ──
// Truth lives HERE, never in the sandbox: every write goes through the MCP
// tools or the dashboard (both into agent-memory-service). The head row is
// the current state, materialized for fast reads, the turn-start index, and
// query-time search; agent_memory_revisions holds a full snapshot of every
// state that ever existed. Agent-level only by decision (2026-08-07):
// workspace-shared memory is a recorded maybe-later (plans/v2-todo.md), and
// nothing here blocks that additive migration.
model AgentMemory {
  id              String  @id @default(uuid())
  agentId         String  @map("agent_id")
  // The stable handle: kebab-case, the memory_save upsert target, and
  // (step 9) the projected file name. Immutable after create — it is the
  // agent's own reference to this memory.
  key             String
  title           String?
  // The one-line index entry. Null = the turn-start index derives a line
  // from content at render time — deliberately not stored, so a content
  // edit can never desync a stored derivation.
  description     String?
  // Markdown body. Two door-specific bounds: memory_save keeps
  // MEMORY_CONTENT_MAX_LENGTH (12k — the tool-args ceiling); the dashboard
  // and the memory-file harvest accept MEMORY_FILE_CONTENT_MAX_CHARS (100k),
  // gated by the exact frame-deliverability check (memoryFileFitsFrame).
  content         String
  // The revision allocator, mirroring Conversation.lastSeq: bumped by an
  // atomic increment inside every write transaction, so the row lock
  // serializes concurrent saves and seq order is commit order. Doubles as
  // "total saves ever" (pruning deletes old rows, never renumbers).
  lastRevisionSeq Int     @default(0) @map("last_revision_seq")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent     Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  revisions AgentMemoryRevision[]

  // The leading column also serves plain agentId lookups — no separate index.
  @@unique([agentId, key])
  @@map("agent_memories")
}

// Full snapshots of a memory's state AS WRITTEN — the repo's first history
// table. Append-only with ONE deliberate exception: redaction scrubs a
// snapshot in place (that is redaction's entire point; the stamp and the
// audit log record that it happened). The head always mirrors the
// highest-seq revision, which is why redacting the latest is refused.
// Retention: the newest MEMORY_REVISIONS_RETAINED rows, pruned in the save
// transaction; lastRevisionSeq keeps counting.
model AgentMemoryRevision {
  id              String @id @default(uuid())
  memoryId        String @map("memory_id")
  // 1-based, allocated by AgentMemory.lastRevisionSeq. Dense except the
  // pruned prefix.
  seq             Int
  // "save" (create, edit, tool upsert) | "restore" (snapshot copied from an
  // earlier revision; creation is just save at seq 1). Redaction is NOT an
  // op — it is a scrub of an existing row, recorded by the stamp below.
  // Coherence with restoredFromSeq is a CHECK in the migration (Prisma
  // cannot express it).
  op              String
  restoredFromSeq Int?   @map("restored_from_seq")

  // The snapshot: head state at this seq. On a redacted revision all three
  // are scrubbed.
  title       String?
  description String?
  content     String

  // "user" (dashboard/API) | "agent" (the tool channel). Tells you how to
  // read authorUserId: for "user" it IS the editor; for "agent" it is the
  // resolved via-user whose ask the write carried (the cron-audit
  // precedent), null when the turn had none (e.g. a scheduled run).
  authorKind   String  @map("author_kind")
  authorUserId String? @map("author_user_id")
  // Denormalized at write time (the AuditLog convention): attribution
  // survives user deletion, which SetNulls the FK.
  authorEmail  String? @map("author_email")

  // Provenance, PLAIN STRINGS by design — no FK: direct threads cascade-
  // delete with their user, and history must dangle gracefully, never
  // follow. The UI resolves live and shows a miss as a deleted origin.
  conversationId String? @map("conversation_id")
  turnId         String? @map("turn_id")

  // The scrub stamp. redactedBy is SetNull — a redaction outlives its
  // redactor (hence the one-way CHECK in the migration).
  redactedAt       DateTime? @map("redacted_at")
  redactedByUserId String?   @map("redacted_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  memory     AgentMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  authorUser User?       @relation("MemoryRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  redactedBy User?       @relation("MemoryRevisionRedactor", fields: [redactedByUserId], references: [id], onDelete: SetNull)

  @@unique([memoryId, seq])
  @@map("agent_memory_revisions")
}

// ── Skills: user-authored capabilities as files (plans/hosted-agents-v2.md step 9, §3.7/§3.8) ──
// Truth lives HERE; the sandbox copy is a regenerated read-only projection
// (the memory-projection law). Three tiers — agent / workspace / organization —
// with exactly one owner column set (CHECKs in the migration; Prisma cannot
// express them). The same NAME may exist at different tiers: the composer
// materializes the most specific one (agent > workspace > organization).
model Skill {
  id             String  @id @default(uuid())
  // "agent" | "workspace" | "organization" — pinned to whichever owner column
  // is set by the scope-coherence CHECK (migration).
  scope          String
  agentId        String? @map("agent_id")
  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")

  // THE directory name inside the sandbox (.agents/skills/<name>/) — kebab,
  // ≤64, immutable after create ("onecli-gateway" is reserved). Immutability
  // is what keeps the supervisor's prune-by-manifest honest across edits.
  name        String
  // Required: it IS the frontmatter line the harness reads to decide when to
  // load the skill. Single line, ≤500 (validations/skills.ts).
  description String
  // The SKILL.md body. ≤24_000; body + extra files together are capped by
  // MAX_SKILL_TOTAL_CHARS — the sync-frame budget governor.
  content     String
  // Pause without delete: a disabled row simply leaves the projection; it
  // does NOT veto a same-named row at a broader tier (filtered before the
  // shadow merge).
  enabled     Boolean @default(true)

  // Human authorship (skills are human-authored; no revision history —
  // unlike memory's agent-written churn). Email denormalized at write time,
  // the AuditLog convention: attribution survives user deletion.
  createdByUserId String? @map("created_by_user_id")
  createdByEmail  String? @map("created_by_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Agent tier dies with its agent. Workspace/org tiers are Restrict ON
  // PURPOSE: the hand-written service cascades own them
  // (deleteWorkspaceContent / deleteOrganizationContent) — a forgotten entry
  // fails the delete loudly instead of silently orphaning rows.
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("SkillCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  files        SkillFile[]

  // Per-owner name uniqueness, one plain unique per tier: the one-owner
  // CHECK zeroes the other columns and Postgres NULLS DISTINCT keeps NULL
  // rows out of contention, so no partial index is needed and everything
  // stays in PSL. Leading columns double as the tier lookup indexes.
  @@unique([agentId, name])
  @@unique([workspaceId, name])
  @@unique([organizationId, name])
  @@map("skills")
}

// Extra files of one skill (references, templates) — the repo's first
// multi-file content, deliberately a child table rather than a Json blob.
// `path` is RELATIVE under .agents/skills/<name>/, ≤2 segments, each
// starting [a-z0-9] (".." and absolute paths are unrepresentable by the
// validation pattern; the composer re-verifies containment as the braces).
// "skill.md" is refused — it collides with the rendered SKILL.md on
// case-insensitive filesystems.
model SkillFile {
  id      String @id @default(uuid())
  skillId String @map("skill_id")
  path    String
  content String // ≤24_000; counted into MAX_SKILL_TOTAL_CHARS

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, path])
  @@map("skill_files")
}

// ── Channels: external messaging surfaces (plans/hosted-agents-v2.md step 6) ──
// The platform layer is provider-neutral: "slack" is the first provider id,
// WhatsApp/Teams are later entries in the same registry. Provider-specific
// payloads live in encrypted, provider-opaque JSON blobs (getCrypto()) —
// never as provider-shaped columns.

// The org's link to one provider tenant (Slack: a workspace). The stored
// credential is the org-level automation credential (Slack: the rotating
// app-configuration token pair {accessToken, refreshToken}) and it is
// OPTIONAL by design: the paste floor mints integrations with no credential —
// the org credential is an accelerator, never a gate (§3.16).
model ChannelIntegration {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  provider             String // "slack"
  externalId           String    @map("external_id") // provider tenant id (Slack: team id)
  name                 String?
  credentials          String? // encrypted provider JSON; null on paste-floor integrations
  credentialsRotatedAt DateTime? @map("credentials_rotated_at")
  // The proactive sweep's claim lease (the claim-CTE pattern): stamped when a
  // sweep pass claims this row so N adapter instances' hourly sweeps rotate
  // DISJOINT sets — Slack's config-token refresh half is single-use, so two
  // concurrent rotations of one row would consume it twice and brick the
  // credential. Single-purpose clock: NEVER `credentialsRotatedAt` (that is
  // the staleness truth; leasing on it would push a crashed claimer's retry
  // to the 12h token expiry with zero margin).
  rotateClaimedAt      DateTime? @map("rotate_claimed_at")
  createdByUserId      String?   @map("created_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?                 @relation("ChannelIntegrationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  agentChannels AgentChannel[]
  userLinks     ChannelUserLink[]
  installations ChannelInstallation[]
  reachGrants   AgentReachGrant[]

  @@unique([organizationId, provider])
  @@index([provider, externalId])
  @@map("channel_integrations")
}

// One workspace-level install of the SHARED (OneCLI-distributed) provider app
// (Slack: the "Add to Slack" one-click install). It powers team onboarding
// (the bot that answers DMs with an account button) and — when the installing
// admin granted the app-manager user scopes — minting per-agent apps without
// a pasted config token. `(provider, externalId)` is globally unique: inbound
// events on the shared app resolve by provider tenant id (Slack: team id),
// and two orgs claiming one workspace would make that routing ambiguous —
// the first installer wins, the second gets a conflict at install.
model ChannelInstallation {
  id              String   @id @default(uuid())
  integrationId   String   @map("integration_id")
  provider        String // "slack"
  externalId      String   @map("external_id") // provider tenant id (Slack: team id)
  // The shared app's provider-side id (Slack: the app id from the OAuth
  // exchange) — recorded so inbound payloads can be cross-checked and so a
  // deployment that rotates its shared app can tell old installs apart.
  appId           String   @map("app_id")
  // The shared bot's own user id (Slack: `U…`) — the inbound arm's echo
  // guard, so the onboarding bot never answers its own posts.
  botUserId       String?  @map("bot_user_id")
  // Encrypted provider JSON (Slack: {botToken, userToken?, userTokenScopes?,
  // managerAppRefused?}). The user token is the installing admin's app-manager
  // grant (mints per-agent apps); `managerAppRefused` is the sticky mark set
  // when Slack answers `invalid_manager_app`, cleared by a reinstall.
  credentials     String
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("ChannelInstallationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@unique([integrationId, provider])
  @@map("channel_installations")
}

// The agent's presence on a provider (Slack: its own app — own name, own DM).
// One presence per provider per agent; a second provider later is another row,
// never a second meaning for this one.
model AgentChannel {
  id                  String    @id @default(uuid())
  agentId             String    @map("agent_id")
  integrationId       String    @map("integration_id")
  provider            String // "slack"
  externalId          String    @map("external_id") // the agent's own provider app id (Slack: app id)
  // Which app flavor THIS app was built as ("agent" | "regular") — stamped at
  // create, like `transport`: the provider-side config baked it in and (Slack)
  // the agent flavor is irreversible, so the presence must remember what it
  // is. New apps are always "agent"; "regular" survives on pre-existing rows
  // (default "regular": every app predating the column was a plain bot) and
  // the runtime honors the stamp — loader for agent apps, emoji receipt for
  // regular ones. Switching = detach/re-attach.
  appMode             String    @default("regular") @map("app_mode")
  identityRef         String?   @map("identity_ref") // the presence's own identity (Slack: bot user id)
  /// The app's own display handle on the provider (Slack: the bot's `user`
  /// from `auth.test`, e.g. "donna"). Captured at completion from a call we
  /// already make. Nullable: the events arm completes via OAuth, and older
  /// presences predate this — surfaces fall back to the external id.
  identityName        String?   @map("identity_name")
  // "events" = the provider calls our public HTTPS inbound routes (the
  // one-click posture) | "socket" = the adapter holds an outbound connection
  // (the no-ingress floor). Stamped at create from the deployment posture —
  // the provider manifest baked one or the other, so the presence must
  // remember which it is. Switching = detach/re-attach in v2.
  transport           String
  // Encrypted provider JSON. Slack: {clientId, clientSecret, signingSecret,
  // botToken?, appToken?} — client creds + signing secret arrive from
  // apps.manifest.create and are needed for the events arm's OAuth exchange
  // and inbound signature verification before any bot token exists.
  credentials         String?
  // "needs_attention" = the approvals service key is being refused (its owner
  // lost workspace access); everything else about the presence keeps working.
  status              String    @default("pending_setup") // "pending_setup" | "active" | "disabled" | "needs_attention"
  createdByUserId     String?   @map("created_by_user_id")
  // The service API key (ApiKey.kind "service") the adapter uses to list and
  // decide gateway approvals for this presence. Revoked at detach.
  apiKeyId            String?   @map("api_key_id")
  // The presence-ownership claim (§3.17): which adapter instance serves this
  // presence, under a lease renewed by its config poll. ⚠️ These two columns
  // are written by RAW SQL ONLY (channel-adapter-service.ts) — a Prisma
  // update would bump `updatedAt`, which is a config-feed etag input, and a
  // lease renewal that busts the etag every poll recreates the KMS decrypt
  // storm the ownership design exists to kill. `SetNull` on the owner FK
  // makes adapter-row reaping safe: the presence becomes unowned and is
  // claimed on a peer's next poll.
  ownerAdapterId      String?   @map("owner_adapter_id")
  ownerLeaseExpiresAt DateTime? @map("owner_lease_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  agent           Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  integration     ChannelIntegration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  ownerAdapter    ChannelAdapter?         @relation("PresenceOwner", fields: [ownerAdapterId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation("AgentChannelCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?                 @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  threadLinks     ChannelThreadLink[]
  ingestedEvents  ChannelIngestedEvent[]
  approvalPrompts ChannelApprovalPrompt[]
  turnReceipts    ChannelTurnReceipt[]

  @@unique([agentId, provider])
  // Unique, not merely indexed: the inbound webhook arm resolves a presence by
  // (provider, externalId=Slack app id), and the app id is USER-SUPPLIED on the
  // paste floor with no ownership proof (auth.test returns team/bot, never the
  // app id). Two presences sharing one app id would let a hostile tenant squat
  // a victim's app id and shadow their inbound routing. The unique makes the
  // collision a CONFLICT at attach instead.
  @@unique([provider, externalId])
  @@index([integrationId])
  @@index([ownerAdapterId])
  @@map("agent_channels")
}

// Provider user ↔ platform user, per integration. Minted lazily on a
// verified-email match or explicitly by an org admin; the workspace-access
// fence is always evaluated on the PLATFORM user this resolves to.
model ChannelUserLink {
  id             String   @id @default(uuid())
  integrationId  String   @map("integration_id")
  externalUserId String   @map("external_user_id")
  userId         String   @map("user_id")
  linkedVia      String   @map("linked_via") // "email" | "manual"
  createdAt      DateTime @default(now()) @map("created_at")

  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  user        User               @relation("ChannelUserLinkUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalUserId])
  @@unique([integrationId, userId])
  @@map("channel_user_links")
}

// The agent's REACH ledger (who may talk to it), one row per granted subject
// - provider-generic on purpose: today's rows are Slack spaces, and the
// designed follow-ups (person grants for stranger DMs, outbound sends) are
// new `subjectKind` values on this same table, not new tables. Reach is a
// separate axis from workspace access (governance): the identity lane
// (`authorizeSpeaker`) always runs FIRST and is never narrowed by a row
// here - a grant can only widen who is answered, never restrict a member.
//
// Keyed by (agent, integration, kind, externalRef) - NOT by agentChannelId -
// so a presence detach/re-attach never silently wipes decided grants.
// Precedence law (reserved for person rows): a person-level denied/blocked
// beats a space-level approved.
model AgentReachGrant {
  id            String  @id @default(uuid())
  agentId       String  @map("agent_id")
  integrationId String  @map("integration_id")
  provider      String // "slack"
  // "space" = a whole group surface (Slack: a channel); "external_user" is
  // the reserved person kind (the knock) - nothing writes it yet.
  subjectKind   String  @map("subject_kind")
  // Provider-opaque subject address (Slack space rows: the channel id).
  externalRef   String  @map("external_ref")
  // Display-only label captured at create (Slack: "#channel-name"); never
  // used for matching - names rename, ids don't.
  subjectLabel  String? @map("subject_label")
  state         String  @default("pending") // "pending" | "approved" | "denied" | "revoked"

  // The owner-DM approval cards posted for this grant, claim-before-post
  // (the ChannelApprovalPrompt lesson): [{channel, ts, userId}]. Recorded so
  // a decide can rewrite EVERY owner's card and a retry never double-posts.
  // Empty array = claimed, nothing posted yet (the sweep's retry cue).
  promptRefs Json? @map("prompt_refs")

  decidedByUserId String?   @map("decided_by_user_id")
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  agent       Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  decidedBy   User?              @relation("ReachGrantDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([agentId, integrationId, subjectKind, externalRef])
  @@index([agentId, state])
  @@map("agent_reach_grants")
}

// Provider thread ↔ conversation: the adapter's routing table. "direct" rows
// bind a user's provider DM to their one direct thread; "group" rows bind a
// provider-defined group thread (Slack: "<channelId>:<threadRootTs>") to its
// own conversation.
model ChannelThreadLink {
  id               String    @id @default(uuid())
  agentChannelId   String    @map("agent_channel_id")
  conversationId   String    @unique @map("conversation_id")
  externalThreadId String    @map("external_thread_id")
  kind             String // "direct" | "group"
  externalUserId   String?   @map("external_user_id") // direct rows: the provider user
  // Mirror/catch-up progress: createdAt of the last finished turn this link
  // has posted to the provider. Persisted here so an adapter restart never
  // double-posts and a missed answer is caught up exactly once.
  mirrorCursor     DateTime? @map("mirror_cursor")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  agentChannel AgentChannel @relation(fields: [agentChannelId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([agentChannelId, externalThreadId])
  @@map("channel_thread_links")
}

// At-least-once delivery insurance: providers redeliver events (unacked
// envelopes, reconnects, webhook retries), and adapter memory dies with the
// process — so idempotency lives HERE. Doors insert first; a P2002 means
// "already ingested" and the door answers duplicate. Pruned opportunistically
// (>24h) on insert.
model ChannelIngestedEvent {
  id             String   @id @default(uuid())
  agentChannelId String   @map("agent_channel_id")
  eventId        String   @map("event_id")
  createdAt      DateTime @default(now()) @map("created_at")

  agentChannel AgentChannel @relation(fields: [agentChannelId], references: [id], onDelete: Cascade)

  @@unique([agentChannelId, eventId])
  @@map("channel_ingested_events")
}

// One approval, one provider prompt. Recorded BEFORE posting so a restarted
// adapter neither re-posts a card nor loses the handle it needs to update one
// on decide/expiry.
model ChannelApprovalPrompt {
  id                 String    @id @default(uuid())
  approvalId         String    @unique @map("approval_id")
  agentChannelId     String    @map("agent_channel_id")
  externalThreadId   String    @map("external_thread_id")
  externalMessageRef String?   @map("external_message_ref")
  state              String    @default("pending") // "pending" | "decided" | "expired"
  // The gateway's own deadline for this approval, recorded at claim time so a
  // restarted adapter re-arms the card with the REAL expiry instead of
  // guessing — otherwise a fast restart marks a still-live approval "timed
  // out" minutes early.
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  agentChannel AgentChannel @relation(fields: [agentChannelId], references: [id], onDelete: Cascade)

  @@map("channel_approval_prompts")
}

// The reaction receipt: an accepted provider message is marked "seen" with an
// emoji reaction, removed once the answer posts. One row per turn, written by
// the detached post-accept task and deleted by the cursor-advance clear; a
// provider-side ledger only — no Turn FK on purpose (rows are pruned by age
// >24h on insert, which also covers turns whose cursor never advances).
model ChannelTurnReceipt {
  id             String    @id @default(uuid())
  turnId         String    @unique @map("turn_id")
  agentChannelId String    @map("agent_channel_id")
  // Provider-opaque address of the USER's message the mark sits on
  // (Slack: channel id + message ts). For `kind: "session"` rows, `messageTs`
  // is the THREAD ROOT ts the provider's work-status API is keyed by.
  channel        String
  messageTs      String    @map("message_ts")
  // "reaction" = an emoji sits on the message and must come off on clear;
  // "session" = the provider's native thread work-status (Slack: the agent
  // session loader) is on and must be set back on clear.
  kind           String    @default("reaction")
  // The emoji, for reaction rows. Null on session rows — there is nothing
  // to take off a specific message.
  reaction       String?
  // The provider-side id of the live NARRATION card for this turn (Slack:
  // the message ts of the task-card post). Null until the turn runs its
  // first tool, and on providers that cannot narrate at all. It lives HERE
  // rather than in its own table because its lifetime is exactly this row's:
  // posted while the turn works, removed by the same clear and sweep paths
  // that take the loader down, so an abandoned card is impossible by
  // construction.
  cardTs         String?   @map("card_ts")
  // Where the narration card is POSTED: the thread root for a group mention,
  // NULL for a DM. Distinct from `messageTs` on purpose — that is the
  // session root the native loader is keyed by, which a DM must have (Slack
  // refuses a session without one) but which the card must NOT use, or every
  // DM turn would open a thread for a loader nobody asked to keep.
  cardThreadTs   String?   @map("card_thread_ts")
  // Whether the provider's native work-status was actually turned on for
  // this turn. False when the card carries the whole signal (a DM, where
  // the enum would open a thread for nothing), and the clear must then NOT
  // try to set a status that was never set.
  workStatusSet  Boolean   @default(false) @map("work_status_set")
  // Where a SEEN mark sits, when one rides beside a narration card. On a
  // session row `messageTs` is the thread root, not the user's message, so
  // the emoji's own address has to be kept separately or the clear would
  // try to unreact the wrong line.
  seenMessageTs  String?   @map("seen_message_ts")
  // The steps shown on that card, oldest first — the turn's whole narration
  // so far. The card is RE-RENDERED from this list on every update rather
  // than patched, so this is the single source of what the reader sees, and
  // it survives a process restart because it lives here rather than in
  // adapter memory.
  cardSteps      String[]  @map("card_steps")
  // How many times the card has been written. The narration's compare-and-set
  // key: two detached pushes for one turn read the same revision, and only
  // the one whose update still matches it proceeds — an array cannot serve
  // as that key (Prisma's list `equals` does not match an empty column, so
  // the first claim of every turn would fail).
  cardRev        Int       @default(0) @map("card_rev")
  // When the card was last written, for the narration throttle. Slack's
  // write is rate-limited per app, and tool boundaries alone do not bound
  // it — a busy agent runs tools faster than the ceiling allows.
  cardAt         DateTime? @map("card_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  agentChannel AgentChannel @relation(fields: [agentChannelId], references: [id], onDelete: Cascade)

  @@map("channel_turn_receipts")
}

// A registered channel-adapter daemon — the outbound service that holds
// provider connections and posts answers/mirrors/approval prompts. Mirrors
// Runner's shape: the token is the operator-provisioned anchor
// (CHANNEL_ADAPTER_TOKEN), the row is minted at registration.
model ChannelAdapter {
  id         String    @id @default(uuid())
  name       String
  token      String    @unique // "cha_..." prefix — the anchor (legacy) or a per-instance mint
  // "anchor" = the legacy shared-anchor identity (old binaries present the
  // anchor itself; at most one such row per configured anchor). "instance" =
  // a per-instance credential minted at registration. Drives the steal/reap
  // rules and the config-feed etag recipe — anchor callers keep mirror
  // cursors folded into the etag (their only CAS-seed source), instance
  // callers get the floor per work item instead.
  kind       String    @default("anchor") // "anchor" | "instance"
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  ownedChannels AgentChannel[] @relation("PresenceOwner")

  @@map("channel_adapters")
}

model Secret {
  id              String        @id @default(uuid())
  scope           String        @default("workspace") // "workspace" | "organization"
  workspaceId     String?       @map("workspace_id")
  organizationId  String?       @map("organization_id")
  name            String
  type            String // "anthropic", "generic"
  // Value source: "inline" (encryptedValue) or "onepassword" (resolved from opRef at request time)
  valueSource     String        @default("inline") @map("value_source")
  encryptedValue  String?       @map("encrypted_value") // AES-256-GCM via CryptoService; null when valueSource = "onepassword"
  opRef           String?       @map("op_ref") // 1Password reference op://vault/item/field (valueSource = "onepassword")
  hostPattern     String        @map("host_pattern") // "api.anthropic.com" or "*.example.com"
  pathPattern     String?       @map("path_pattern") // "/v1/*", null = all paths
  injectionConfig Json?         @map("injection_config") // type-specific config (generic: { headerName, valueFormat })
  metadata        Json? // type-specific metadata (anthropic: { authMode: "api-key" | "oauth" })
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  workspace       Workspace?    @relation(fields: [workspaceId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])

  budgets           Budget[] // cloud-only: spend budgets on this secret (inert in OSS)
  policyRuleTargets PolicyRuleTarget[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([scope])
  @@map("secrets")
}

// ── Unified policy engine ──────────────────────────────────────────────────
// Priority-ordered, first-match rules — the LIVE policy model since the step-5
// cutover.

model PolicyRuleV2 {
  id              String   @id @default(uuid())
  scope           String // "organization" | "workspace"
  organizationId  String?  @map("organization_id")
  workspaceId     String?  @map("workspace_id")
  status          String   @default("draft") // "draft" | "published" (gateway reads published)
  generation      Int      @default(0) // published snapshot number (rollback)
  priority        Int // first-match order within a scope (lower = earlier)
  enabled         Boolean  @default(true)
  isDefault       Boolean  @default(false) @map("is_default") // terminal Default Rule
  // A generation-stable identity: a draft's `logicalId` is copied onto each of its
  // published snapshots, so the gateway's rate-limit counter (keyed on it) survives
  // republishes — unlike the per-generation row `id`. Distinct rules get distinct
  // values (defaulted); a snapshot copies its source draft's.
  logicalId       String   @default(dbgenerated("gen_random_uuid()")) @map("logical_id")
  // Origin of the rule: "custom" (authored) | "app_permission" | "blocklist"
  // (materialized from the old model by the step-5 coherence bridge, until the
  // old editors retire at step 7) | "default" (the terminal posture rule) |
  // "equipment" (step 8, injection-only, derived from the live equipment
  // model). The bridge re-materializes only the app_permission/blocklist/
  // equipment rows, leaving custom + default untouched.
  source          String   @default("custom")
  name            String
  description     String?
  action          String // "allow" | "block"
  rateLimit       Int?     @map("rate_limit") // modifier on allow
  rateLimitWindow String?  @map("rate_limit_window") // "minute" | "hour" | "day"
  requireApproval Boolean  @default(false) @map("require_approval") // modifier on allow
  conditions      Json?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?                @relation("PolicyRuleV2Creator", fields: [createdByUserId], references: [id])
  identities    PolicyRuleIdentity[]
  targets       PolicyRuleTarget[]

  @@index([scope, organizationId, workspaceId, status, priority])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("policy_rules_v2")
}

// One identity row per (rule, principal). Empty set on a rule = "any identity".
// Exactly one of the three principal columns is set (DB CHECK).
model PolicyRuleIdentity {
  id      String  @id @default(uuid())
  ruleId  String  @map("rule_id")
  agentId String? @map("agent_id")
  userId  String? @map("user_id")
  groupId String? @map("group_id")

  rule  PolicyRuleV2 @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  agent Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User?        @relation("PolicyRuleIdentityUser", fields: [userId], references: [id], onDelete: Cascade)
  group Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // A rule binds each principal at most once (mirrors the sibling access tables).
  @@unique([ruleId, agentId])
  @@unique([ruleId, userId])
  @@unique([ruleId, groupId])
  @@index([agentId])
  @@index([userId])
  @@index([groupId])
  @@map("policy_rule_identities")
}

// One target row per (rule, destination). Empty set on a rule = "any
// destination". `kind` selects which columns are populated (DB CHECK).
model PolicyRuleTarget {
  id                 String   @id @default(uuid())
  ruleId             String   @map("rule_id")
  kind               String // "app" | "connection" | "secret" | "network"
  appProvider        String?  @map("app_provider") // kind = app
  // Narrow which endpoints the rule matches; EMPTY = the WHOLE app (host-only
  // on the provider's catalog hosts — permit on allow / block on block). On a
  // kind = connection target the tools narrow the connection's provider app the
  // same way; injection still injects the whole connection regardless.
  appTools           String[] @default([]) @map("app_tools")
  // kind = app (step 8): "organization" | "workspace" → inject ALL the agent's
  // connections of `appProvider` at that level. NULL = the app-permission
  // block/allow rule (no injection). Only set when kind = "app".
  appConnectionScope String?  @map("app_connection_scope")
  appConnectionId    String?  @map("app_connection_id") // kind = connection
  secretId           String?  @map("secret_id") // kind = secret
  // kind = secret (step 8): "organization" | "workspace" → inject ALL the agent's
  // secrets at that level ("all secrets"). Mutually exclusive with `secretId`
  // (specific secret). Only set when kind = "secret".
  secretScope        String?  @map("secret_scope")
  hostPattern        String?  @map("host_pattern") // kind = network
  pathPattern        String?  @map("path_pattern")
  method             String?

  rule          PolicyRuleV2   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  appConnection AppConnection? @relation(fields: [appConnectionId], references: [id], onDelete: Cascade)
  secret        Secret?        @relation(fields: [secretId], references: [id], onDelete: Cascade)

  // A rule references a given connection / secret at most once (app + network
  // rows are polymorphic — deduped in the app layer, per the plan §2.2).
  @@unique([ruleId, appConnectionId])
  @@unique([ruleId, secretId])
  @@index([ruleId])
  @@index([appConnectionId])
  @@index([secretId])
  @@index([appProvider])
  @@map("policy_rule_targets")
}

model AuditLog {
  id             String        @id @default(uuid())
  workspaceId    String?       @map("workspace_id")
  organizationId String?       @map("organization_id")
  userId         String        @map("user_id")
  userEmail      String        @map("user_email")
  action         String
  service        String
  status         String
  source         String        @default("app")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model RequestLog {
  id                   String   @id @default(uuid())
  workspaceId          String   @map("workspace_id")
  agentId              String   @map("agent_id")
  method               String
  host                 String
  path                 String
  provider             String
  status               Int
  latencyMs            Int      @map("latency_ms")
  injectionCount       Int      @map("injection_count")
  extraData            Json?    @map("extra_data")
  // The generation-stable logicalId of the v2 policy rule that decided the
  // request (step 9 visibility) — null for legacy decisions, plain allows,
  // pre-v2 rows, and OSS (its writer never binds it). The display NAME rides
  // extra_data.matched_rule_name (survives rule deletion).
  matchedRuleLogicalId String?  @map("matched_rule_logical_id")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("request_logs")
}

model VaultConnection {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  provider        String
  name            String?
  status          String
  connectionData  Json?     @map("connection_data")
  lastConnectedAt DateTime? @map("last_connected_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, provider])
  @@map("vault_connections")
}

model OnboardingSurvey {
  id          String    @id @default(uuid())
  workspaceId String    @unique @map("workspace_id")
  userId      String    @map("user_id")
  userEmail   String    @map("user_email")
  useCase     String?   @map("use_case")
  discovery   String[]  @default([])
  responses   Json      @default("{}")
  setupState  Json?     @map("setup_state")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("onboarding_surveys")
}

// ── App connections ──────────────────────────────────────────────────────

model AppConnection {
  id                String             @id @default(uuid())
  scope             String             @default("workspace") // "workspace" | "organization"
  workspaceId       String?            @map("workspace_id")
  organizationId    String?            @map("organization_id")
  // The AppConfig whose credentials minted this connection (OAuth refresh
  // tokens are bound to that client). Null = platform/env credentials, a
  // connection method that needs no config, or minted before this link.
  appConfigId       String?            @map("app_config_id")
  provider          String // "github", "gmail", "google-calendar", "google-drive", etc.
  label             String?            @map("label") // auto-populated from metadata (email/username)
  status            String             @default("connected")
  credentials       String?            @map("credentials") // encrypted JSON (access_token, refresh_token, etc.)
  scopes            String[]           @default([])
  metadata          Json? // non-secret info (username, org, email)
  connectedAt       DateTime           @default(now()) @map("connected_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  workspace         Workspace?         @relation(fields: [workspaceId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  appConfig         AppConfig?         @relation(fields: [appConfigId], references: [id], onDelete: SetNull)
  policyRuleTargets PolicyRuleTarget[]

  @@index([workspaceId, provider])
  @@index([organizationId, provider])
  @@index([scope])
  @@index([appConfigId])
  @@map("app_connections")
}

model AppConfig {
  id             String          @id @default(uuid())
  scope          String          @default("workspace") // "workspace" | "organization"
  workspaceId    String?         @map("workspace_id")
  organizationId String?         @map("organization_id")
  provider       String // "github", "gmail", "google-calendar", "google-drive"
  enabled        Boolean         @default(false)
  credentials    String?         @map("credentials") // encrypted (clientSecret)
  settings       Json? // plain (clientId, scopes)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  // Connections minted with this config's credentials (see AppConnection.appConfigId).
  connections    AppConnection[]

  @@unique([workspaceId, provider])
  @@unique([organizationId, provider])
  @@index([scope])
  @@map("app_configs")
}

// ── Groups, workspace access & role mappings ───────────────────────────────
// Human principals (user | group) for the enterprise directory. Groups gate
// workspace access (WorkspaceAccess) and drive org roles (GroupRoleMapping).

// A human group — manually managed, or provisioned from the customer IdP via
// SCIM (source "scim" rows are locked to IdP management).
model Group {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  source         String   @default("manual") // "manual" | "scim"
  externalId     String?  @map("external_id") // IdP correlation id (SCIM)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  members                       GroupMember[]
  workspaceAccess               WorkspaceAccess[]
  roleMapping                   GroupRoleMapping?
  policyRuleIdentities          PolicyRuleIdentity[]
  appAvailabilityRuleIdentities AppAvailabilityRuleIdentity[]

  @@unique([organizationId, name])
  @@unique([organizationId, source, externalId])
  @@index([organizationId])
  @@map("groups")
}

model GroupMember {
  groupId         String   @map("group_id")
  userId          String   @map("user_id")
  createdByUserId String?  @map("created_by_user_id") // null = SCIM/system write
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  group         Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User  @relation("GroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("GroupMemberCreator", fields: [createdByUserId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// Workspace access bindings — the workspace's human gate (GRANT semantics: a row
// grants access; agents live in workspaces, so no machine columns here).
// Exactly one of userId/groupId per row (DB CHECK).
model WorkspaceAccess {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  userId          String?  @map("user_id")
  groupId         String?  @map("group_id")
  // Management role on a USER binding (step 13c): "owner" may rename/share/delete
  // the workspace; "member" is a plain use grant. Group bindings stay role-less in
  // v1 (member). Only consulted for management — usage (13b) is role-blind.
  role            String   @default("member") // "owner" | "member"
  createdByUserId String?  @map("created_by_user_id") // null = system write (creator seed)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?     @relation("WorkspaceAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("WorkspaceAccessCreator", fields: [createdByUserId], references: [id])

  @@unique([workspaceId, userId])
  @@unique([workspaceId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("workspace_access")
}

// Org-scoped app-availability rules (step 7): a named rule grants a SET of apps
// to a SET of human principals (users | groups), applied when the org's
// appAvailabilityMode is "restricted". Mirrors the PolicyRuleV2 +
// PolicyRuleIdentity shape but is a SEPARATE axis (the provisioning gate, not
// agent runtime policy). Cloud/EE-only; inert in OSS.
model AppAvailabilityRule {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String? // optional label, e.g. "People-management apps"
  providers       String[] @default([]) // granted apps = AppDefinition.ids (empty = no-op)
  createdByUserId String?  @map("created_by_user_id") // null = system write
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization                  @relation(fields: [organizationId], references: [id])
  createdByUser User?                         @relation("AppAvailabilityRuleCreator", fields: [createdByUserId], references: [id])
  identities    AppAvailabilityRuleIdentity[]

  @@index([organizationId])
  @@map("app_availability_rules")
}

// One identity row per (rule, principal). Exactly one of userId/groupId is set
// (DB CHECK). Mirrors PolicyRuleIdentity.
model AppAvailabilityRuleIdentity {
  id      String  @id @default(uuid())
  ruleId  String  @map("rule_id")
  userId  String? @map("user_id")
  groupId String? @map("group_id")

  rule  AppAvailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user  User?               @relation("AppAvailabilityRuleIdentityUser", fields: [userId], references: [id], onDelete: Cascade)
  group Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // A rule binds each principal at most once.
  @@unique([ruleId, userId])
  @@unique([ruleId, groupId])
  @@index([ruleId])
  @@index([userId])
  @@index([groupId])
  @@map("app_availability_rule_identities")
}

// Group → org-role mapping (priority-ordered; the highest-priority mapping
// among a user's groups wins; unmatched users keep their current role).
model GroupRoleMapping {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  groupId        String   @unique @map("group_id")
  role           String // "admin" | "member"
  priority       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("group_role_mappings")
}

// EE (licensed): a pre-minted placeholder account an org admin hands out via a
// claim link (POST /v1/team/provisions → APP_URL/claim?token=…). The table
// predates the workspace rename and carries live pre-2.0 production data, so
// `workspaceId` deliberately has NO relation — it mirrors prod's bare unique
// column (renamed from project_id by its own migration, not the big rename).
model UserProvision {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  userId             String    @unique @map("user_id")
  workspaceId        String    @unique @map("workspace_id")
  role               String // "admin" | "member"
  token              String    @unique
  status             String    @default("pending") // "pending" | "claimed" | "expired"
  skipOnboarding     Boolean   @default(true) @map("skip_onboarding")
  provisionedById    String    @map("provisioned_by_id")
  provisionedByEmail String    @map("provisioned_by_email")
  expiresAt          DateTime  @map("expires_at")
  claimedAt          DateTime? @map("claimed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  user          User         @relation("ProvisionedUser", fields: [userId], references: [id])
  provisionedBy User         @relation("ProvisionCreator", fields: [provisionedById], references: [id])

  @@index([token])
  @@index([organizationId])
  @@index([expiresAt, status])
  @@map("user_provisions")
}

// Cloud-only (inert in OSS): a spend budget on a secret for a consuming scope.
// DORMANT — no surface creates budgets since the partner layer was removed;
// kept (with the gateway budget engine) for a future budget flow (an org or
// workspace capping its own key).
model Budget {
  id             String   @id @default(uuid())
  secretId       String   @map("secret_id")
  organizationId String?  @map("organization_id")
  workspaceId    String?  @map("workspace_id") // future workspace-level scoping
  limitCents     Int      @map("limit_cents")
  period         String   @default("monthly") // "monthly" | "total"
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  secret       Secret        @relation(fields: [secretId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id])

  @@unique([secretId, organizationId]) // one budget per (secret, consuming org)
  @@index([secretId])
  @@index([organizationId])
  @@map("budgets")
}

// Cloud-only (inert in OSS): durable accumulated spend, period-windowed to match
// the gateway's Redis hot counter key. The Redis counter is the hot enforcement
// source of truth; this is the durable floor (rehydrated into Redis on cache miss
// so a flush can't silently refill a budget). `spentNanos` = nano-dollars (1e-9).
// `organizationId` holds a RENDERED BUDGET SUBJECT, not a bare org id: the
// gateway writes `org:<id>` for org budgets and `user:<id>` for the platform
// trial credit (attributed to the org's founding owner). The column keeps its
// historical name; the prefix is what makes the value honest. Never join it
// to organizations without stripping/matching the prefix.
model BudgetSpend {
  secretId       String   @map("secret_id")
  organizationId String   @map("organization_id")
  period         String // "m:YYYY-MM" (monthly window) | "total"
  spentNanos     BigInt   @default(0) @map("spent_nanos")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([secretId, organizationId, period])
  @@map("budget_spends")
}

// ── Standalone (no workspace scoping) ─────────────────────────────────────

model ResendBadEmail {
  id        String   @id @default(uuid())
  email     String
  eventType String   @map("event_type") // "email.bounced" or "email.complained"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("resend_bad_emails")
}

model ResendWebhook {
  id           String   @id @default(uuid())
  eventType    String   @map("event_type") // "email.sent", "email.bounced", "email.complained", etc.
  emailSubject String?  @map("email_subject")
  emailFrom    String?  @map("email_from")
  emailTo      String?  @map("email_to")
  eventData    Json?    @map("event_data")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("resend_webhooks")
}

model CliAuthSession {
  id        String   @id @default(uuid())
  code      String   @unique
  status    String   @default("pending") // "pending" | "confirmed" | "expired"
  apiKey    String?  @map("api_key")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cli_auth_sessions")
}

// ── Self-host identity (better-auth) ──────────────────────────────────────
//
// The three tables better-auth owns on the self-hosted edition. Cloud runs on
// Cognito and never writes them; they are inert there, like every other
// edition-specific table in this schema.
//
// Model and FIELD names are the ones better-auth's adapter addresses (it
// speaks Prisma client names, never physical columns), so they stay camelCase
// and the snake_case columns come from `@map` as everywhere else. The Rust
// gateway reads `sessions` directly in SQL, so it is the one consumer that
// depends on the physical names below.

/// A logged-in browser session. The cookie carries `token` (signed with
/// BETTER_AUTH_SECRET); validating a request is a lookup on this row, so
/// deleting it — sign-out, revocation — takes effect immediately everywhere,
/// including at the gateway.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Expired rows are only cleaned up when their own token is presented again,
  // so a sweep needs this to stay cheap as the table accumulates.
  @@index([expiresAt])
  @@map("sessions")
}

/// A credential attached to a user: `providerId: "credential"` holds the
/// password hash, a social provider holds its OAuth tokens. One row per
/// (provider, provider-side account).
model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexed, deliberately NOT unique: better-auth's own schema declares no
  // uniqueness here and its link path has no conflict handling, so a
  // constraint would turn a harmless duplicate into a 500. This is the lookup
  // it actually performs.
  @@index([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived proof tokens (email verification, password reset). Keyed by
/// `identifier` rather than a user id — the subject may not have an account
/// yet — and swept by expiry.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
